# Pipeline secrets — copy to .env.local.pipeline (gitignored). Never commit real keys.

# Google Places API (New) — server key. Direct calls to places.googleapis.com.
# Enable "Places API (New)" on the GCP project. Restrict key by API if possible.
GOOGLE_MAPS_API_KEY=

# Firecrawl — direct api.firecrawl.dev
FIRECRAWL_API_KEY=

# Gemini / Google Generative AI (for multimodal vision multi-item detection + OCR)
# Get a key from https://aistudio.google.com/apikey or Google Cloud
GOOGLE_GENERATIVE_AI_API_KEY=
# Alias also supported by some SDKs
GEMINI_API_KEY=

# Optional: only if you force Lovable gateway paths
# LOVABLE_API_KEY=
# GOOGLE_PLACES_DIRECT=0
# FIRECRAWL_DIRECT=0

# ── Supabase ───────────────────────────────────────────────────────────────
# The app works without these. The corpus ships as per-region JSON so the
# ranked list is instant and unaffected by an outage; the database adds
# cross-region search, shareable night plans, and enrichment history.

# Client-side. Publishable by design, guarded by row-level security.
# Project: supabase-chestnut-chair / pqbqvrmhbxowpqzcenod
#   VITE_SUPABASE_URL=https://pqbqvrmhbxowpqzcenod.supabase.co
# On Vercel these two must be added by hand. The Supabase integration injects
# SUPABASE_URL / SUPABASE_ANON_KEY, but Vite only exposes VITE_-prefixed
# variables to the browser, so without these the client stays unconfigured.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server / pipeline only. Bypasses row-level security — never expose this to
# the browser, never commit it, never put it in a VITE_ variable.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
