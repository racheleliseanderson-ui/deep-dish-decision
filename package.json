{
  "name": "deep-dish-decision",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-sitemaps.mjs",
    "dev": "vite dev --host 0.0.0.0 --port 8080",
    "prebuild": "node scripts/check-generated.mjs && node scripts/build-sitemaps.mjs",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:live": "node scripts/pipeline/build-live-index.mjs",
    "build:enrichment": "node scripts/pipeline/split-enrichment.mjs",
    "build:atlas": "vite-node scripts/build-atlas.ts",
    "build:slug-index": "node scripts/pipeline/build-slug-index.mjs",
    "build:sitemaps": "node scripts/build-sitemaps.mjs",
    "build:visuals": "node scripts/build-image-derivatives.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 8080",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "check:corpus": "node scripts/corpus-invariants.mjs",
    "pipeline:report": "node scripts/pipeline/report.mjs",
    "pipeline:refresh-queue": "node scripts/pipeline/refresh.mjs",
    "pipeline:hygiene": "node scripts/pipeline/enrich.mjs --hygiene --batch=25",
    "pipeline:enrich": "node scripts/pipeline/enrich.mjs --batch=10",
    "pipeline:enrich:slugs": "node scripts/pipeline/enrich.mjs --slugs",
    "pipeline:resolve": "node scripts/pipeline/resolve-targets.mjs",
    "pipeline:resolve:dry": "node scripts/pipeline/resolve-targets.mjs --dry",
    "pipeline:seed": "node scripts/pipeline/seed-listings.mjs",
    "pipeline:seed:enrich": "node scripts/pipeline/seed-and-enrich.mjs",
    "pipeline:retire": "node scripts/pipeline/retire-closed.mjs",
    "db:seed": "node scripts/db/seed-corpus.mjs",
    "db:seed:dry": "node scripts/db/seed-corpus.mjs --dry-run",
    "validate:seed": "node scripts/validate-seed.mjs",
    "test": "node scripts/check-vendored-parity.mjs && node scripts/check-generated.mjs && vitest run && node --test scripts/corpus-invariants.test.mjs scripts/pipeline/level-records.test.mjs scripts/pipeline/parse-hours.test.mjs scripts/pipeline/resolve-targets.test.mjs && node scripts/corpus-invariants.mjs && node --experimental-strip-types --test tests/salty-handoff.test.ts"
  },
