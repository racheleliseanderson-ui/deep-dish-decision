# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Secrets — never commit API keys
.env
.env.*
!.env.example
.env.local.pipeline
.firecrawl/

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.vercel/
.node_modules.lock

# Git bundles used to hand work between machines — never part of the tree
*.bundle
*.patch

# Generated image widths. Built from assets-src/ by build-image-derivatives.mjs
# and imported by the route, so Vite hashes them — but they are output, not source.
# (Committed deliberately: the deploy machine has no ImageMagick. See
# scripts/check-generated.mjs.)

# Pipeline rollback snapshots. The pipeline writes a dataset copy before each
# run so a bad pass can be undone; they are local safety, not source. 18.6 MB
# of them from one afternoon in August had been committed and never left.
.pipeline-snapshots/

# Retired files live in GitHub/_TO_Delete, outside every repository, so git
# never sees them and the delete scripts have one safe target. This entry is a
# safety net only: if something ever lands in a repo-local _to_delete, it must
# not be committed.
_to_delete/
